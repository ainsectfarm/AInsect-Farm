# AInsekt Farm — Web app env vars
# Copy to .env.local and fill in real values

# Email — Resend.com transactional API
RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY
CONTACT_TO_EMAIL=investor@example.com

# Backend API endpoint (FastAPI)
# Public — bo browser-side fetch
NEXT_PUBLIC_API_URL=http://localhost:8001

# Next.js HMR allowed cross-origin (dev only)
NEXT_PUBLIC_DEV_ORIGIN=127.0.0.1
